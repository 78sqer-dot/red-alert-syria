# Red Alert Syria — environment template (NAMES ONLY — never commit values).
# Secrets live in the hosting panel. See PRODUCTION-STATE doc (ops copy) for
# which variables are required and what breaks without each one.

# --- Bots / Telegram ---
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
REPORT_BOT_TOKEN=
REPORT_BOT_USERNAME=
REPORT_WEBHOOK_SECRET=
WEBHOOK_SECRET=
CHANNEL_ID=
CHANNEL_URL=
OWNER_IDS=
PRIMARY_OWNER_ID=
ADMIN_ID=
ADMIN_API_KEY=

# --- AI (classification service) ---
GEMINI_API_KEY=
NEWS_REWRITE_GEMINI_API_KEY=
NEWS_AI_MODELS=
PRICES_AI_MODELS=
TR_AI_MODELS=
# Backup provider (failover). Until AI_BACKUP_API_KEY is set, classification
# runs Gemini-only and outages HOLD drafts instead of degrading.
AI_BACKUP_API_KEY=
AI_BACKUP_BASE_URL=
AI_BACKUP_MODEL=

# --- Web push (changing these invalidates all existing subscriptions) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Site / runtime ---
PUBLIC_URL=
PORT=
DATA_DIR=
HISTORY_HOURS=
MAX_ALERTS=
BOT_MODE=
KEEP_ALIVE=
RUN_STARTUP_MAINTENANCE=
TELEGRAM_BACKUP=
REPO_URL=

# --- Alert card images ---
ALERT_IMAGES=
ALERT_IMAGE_WIDTH=
ALERT_IMAGE_LOGO=
ALERT_IMAGE_DEADLINE_MS=

# --- SEO verification ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
GOOGLE_VERIFY_FILE=

# --- Analytics (tag is emitted only when UMAMI_SCRIPT_URL is a valid https URL) ---
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# --- Render-provided on the current host (informational; absent elsewhere) ---
RENDER_API_KEY=
RENDER_SERVICE_ID=
